{
  "name": "carejoys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/prepare.mjs && playwright test -c e2e",
    "test:node": "node --no-warnings --test scripts/test-*.mjs",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrations:apply && wrangler deploy",
    "pretest": "node -e \"require('fs').rmSync('.wrangler/test',{recursive:true,force:true})\" && wrangler d1 migrations apply DB --local --config tests/wrangler.test.jsonc --persist-to .wrangler/test",
    "test": "vitest run",
    "zip-geo:build": "node scripts/build-zip-geo.mjs"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "esbuild": ">=0.25.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.102.0",
    "zipcodes": "^8.0.0"
  }
}
