{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carejoys",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  // Playwright for "Apply for me" (src/applyAgentBrowser.ts) needs Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "carejoys.com/*",
      "zone_name": "carejoys.com"
    },
    {
      "pattern": "www.carejoys.com/*",
      "zone_name": "carejoys.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every page goes through the Worker (per-page SEO, real 404s); built files are served straight from assets.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/og/*",
      "!/favicon.png"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carejoys",
      "database_id": "bad7e436-d8af-4c90-b365-54411349c662"
    }
  ],
  // Cloudflare Browser Rendering: fills in employer application forms for "Apply for me".
  "browser": {
    "binding": "BROWSER"
  },
  // Workers AI: writes CareJoys' own summary of each job (src/jobSummary.ts).
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Stream: caregivers' optional intro videos (src/introVideo.ts). Stream must be enabled on the account.
  "stream": {
    "binding": "STREAM"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": [
        "hello@carejoys.com",
        "updates@carejoys.com",
        // Rebecca's own outreach and replies (src/replyYesOutreach.ts, src/adminMail.ts).
        "rebecca@carejoys.com"
      ]
    }
  ],
  // Keeps variables set in the Cloudflare dashboard (MAILING_ADDRESS) through each deploy.
  "keep_vars": true,
  "vars": {
    // Booking page (Calendly, Cal.com…) for the "Book a call" button after the /hire-caregivers form. Empty hides the button.
    "EMPLOYER_CALL_URL": "https://calendly.com/myersrebeccal/30min",
    // Outreach crons send nothing until this is "true". Caps are emails per UTC day.
    "OUTREACH_ENABLED": "false",
    // Paid DataForSEO searches for careers pages the scanner could not find (src/careersLookup.ts), in dollars per UTC day. "0" turns it off.
    "CAREERS_LOOKUP_DAILY_USD": "0.25",
    "CAREERS_LOOKUP_BOOST_USD": "5",
    // "Post your first job" email, once, to agencies that claimed two days ago without posting (src/firstJobNudge.ts). Rebecca approved 2026-10-23 for
    // claims from then on; the 3 agencies that claimed earlier were already pitched, so FIRST_JOB_NUDGE_SINCE leaves them out.
    "FIRST_JOB_NUDGE_ENABLED": "true",
    "FIRST_JOB_NUDGE_SINCE": "2026-10-23 15:40:00",
    "REACTIVATION_DAILY_CAP": "50",
    // One reminder (15:41 UTC cron) to legacy caregivers who got the first email and never confirmed; each gets it once. Rebecca approved 2026-10-08.
    "REACTIVATION_REMINDER_ENABLED": "true",
    "WEEKLY_DIGEST_ENABLED": "true",
    "AGENCY_TEASER_DAILY_CAP": "10",
    // "Verify your agency needs" invites to agencies whose jobs CareJoys lists; separate from OUTREACH_ENABLED.
    "AGENCY_HIRING_INVITES_ENABLED": "true",
    // Raised from 20 to 60 a day (Rebecca approved 2026-10-19).
    "AGENCY_HIRING_INVITE_DAILY_CAP": "60",
    // "openers" or "all": re-send the new invite (PR #154 copy) to agencies that only saw the old one. Blank is off.
    // Off 2026-10-23: the reply-yes note is the only agency email now.
    "AGENCY_HIRING_REINVITE": "",
    // "reply_yes": agency outreach is Rebecca's plain-text reply-yes note from rebecca@ instead of the styled invite and
    // its re-sends (Rebecca chose this 2026-10-22, every state, most jobs first). It sends nothing until rebecca@ is routed
    // to this Worker in Cloudflare Email Routing; the same daily cap applies.
    "AGENCY_OUTREACH_EMAIL": "reply_yes",
    // Facility outreach pilot: sends only to facilities marked in agency_organizations.outreach_pilot, inside the cap above.
    // Off 2026-10-23: Rebecca wants one agency campaign (the reply-yes note) at 60 a day; the pilot's 100 went out 11-12 Oct.
    "FACILITY_PILOT_ENABLED": "false",
    // School outreach is an independent daily channel (no more than 5 per hourly run). Rebecca put schools on hold 2026-10-23.
    "SCHOOL_OUTREACH_ENABLED": "false",
    "SCHOOL_OUTREACH_DAILY_CAP": "15",
    // Twilio SMS to candidates (src/sms.ts). Credentials are secrets (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
    // TWILIO_MESSAGING_SERVICE_SID); nothing is texted until this is "true" and the toll-free number is verified.
    "SMS_ENABLED": "true",
    // Auto-apply to opted-in caregivers' best new matches (up to 3 a day each). Off until Rebecca approves.
    "AUTO_APPLY_ENABLED": "false",
    // Microsoft Clarity tag on public pages (public ID; the Data Export token is the CLARITY_API_TOKEN secret).
    "CLARITY_PROJECT_ID": "ysz8riafaj"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *",
      "41 15 * * *"
    ]
  }
}