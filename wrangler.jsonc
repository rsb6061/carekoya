{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carekoya",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "carejoys.com/*",
      "zone_name": "carejoys.com"
    },
    {
      "pattern": "www.carejoys.com/*",
      "zone_name": "carejoys.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/caregiver-recruiting/*",
      "/hire-caregivers/*",
      "/resources/*",
      "/caregiver-jobs/*",
      "/caregiver-resume",
      "/jobs/*",
      "/about",
      "/training-programs/*",
      "/schools/*",
      "/school/*",
      "/join/*",
      "/privacy-policy",
      "/terms-of-service",
      "/app*",
      "/auth*",
      "/activate*",
      "/respond*",
      "/agency*",
      "/school-auth*",
      "/school-dashboard*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carejoys",
      "database_id": "bad7e436-d8af-4c90-b365-54411349c662"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": [
        "updates@carejoys.com"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 * * * *",
      "41 15 * * *"
    ]
  }
}