{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carekoya",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  // Playwright for "Apply for me" (src/applyAgentBrowser.ts) needs Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "carejoys.com/*",
      "zone_name": "carejoys.com"
    },
    {
      "pattern": "www.carejoys.com/*",
      "zone_name": "carejoys.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every page goes through the Worker (per-page SEO, real 404s); built files are served straight from assets.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/og/*",
      "!/favicon.png"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carejoys",
      "database_id": "bad7e436-d8af-4c90-b365-54411349c662"
    }
  ],
  // Cloudflare Browser Rendering: fills in employer application forms for "Apply for me".
  "browser": {
    "binding": "BROWSER"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": [
        "hello@carejoys.com",
        "updates@carejoys.com"
      ]
    }
  ],
  "vars": {
    // Outreach crons send nothing until this is "true". Caps are emails per UTC day.
    "OUTREACH_ENABLED": "false",
    "REACTIVATION_DAILY_CAP": "50",
    "AGENCY_TEASER_DAILY_CAP": "10",
    // Microsoft Clarity tag on public pages (public ID; the Data Export token is the CLARITY_API_TOKEN secret).
    "CLARITY_PROJECT_ID": "ysz8riafaj"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 * * * *",
      "2,32,47 * * * *",
      "41 15 * * *"
    ]
  }
}