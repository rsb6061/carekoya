{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carekoya",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "carejoys.com/*",
      "zone_name": "carejoys.com"
    },
    {
      "pattern": "www.carejoys.com/*",
      "zone_name": "carejoys.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carejoys",
      "database_id": "bad7e436-d8af-4c90-b365-54411349c662"
    }
  ]
}